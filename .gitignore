# The full-quality source files stay on this machine. What ships publicly are
# the smaller copies under music/web/, and only for tracks whose artists allow
# reuse - each one marked pub:true in music/tracks.js, credited by name in the
# game's credits screen. Anything unmarked has no file online at all.
assets-local/music/
music/*.mp3

# ...except the artist-cleared copies, which do ship with the public site.
!music/web/

# local like-server data
server/stats.json

.DS_Store
server/stats.json.bak*
